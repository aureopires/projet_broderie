{% extends 'admin/base.html.twig' %}

{% block mainTitle %}
<!DOCTYPE html>

<title>QuoteRequest index</title>
{% endblock %}

{% block body %}
    <h1>QuoteRequest index</h1>

    <a href="{{ path('admin_quote_request_new') }}">Create new</a>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Email</th>
                <th>Message</th>
                <th>Status</th>
                <th>CreatedAt</th>
                <th>Article</th>
                <th>Origine</th>
                <th>Marquage</th>
                <th>Logo</th>
                <th>Quantité</th>
                <th>Organisme</th>
                <th>Nom organisme</th>
                <th>Téléphone</th>
                <th>Utilisateur</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for quote_request in quote_requests %}
            <tr>
                <td>{{ quote_request.id }}</td>
                <td>{{ quote_request.name }}</td>
                <td>{{ quote_request.email }}</td>
                <td>{{ quote_request.message }}</td>
                <td>{{ quote_request.status }}</td>
                <td>{{ quote_request.createdAt ? quote_request.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ quote_request.articleType }}</td>
                <td>{{ quote_request.articleOrigin }}</td>
                <td>{{ quote_request.markingType }}</td>
                <td>{{ quote_request.logo }}</td>
                <td>{{ quote_request.quantity }}</td>
                <td>{{ quote_request.organizationType }}</td>
                <td>{{ quote_request.organizationName }}</td>
                <td>{{ quote_request.phone }}</td>
                <td>{{ quote_request.user ? quote_request.user.id : '' }}</td>
                <td>
                    <a href="{{ path('admin_quote_request_show', {'id': quote_request.id}) }}">show</a>
                    <a href="{{ path('admin_quote_request_edit', {'id': quote_request.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="16">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
