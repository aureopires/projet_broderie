{% extends 'admin/base.html.twig' %}

{% block mainTitle %}
<!DOCTYPE html>

<title>QuoteRequest</title>
{% endblock %}

{% block body %}
    <h1>QuoteRequest</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quote_request.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ quote_request.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ quote_request.email }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ quote_request.message }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ quote_request.status }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ quote_request.createdAt ? quote_request.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_quote_request_index') }}">back to list</a>

    <a href="{{ path('admin_quote_request_edit', {'id': quote_request.id}) }}">edit</a>

    {{ include('admin/admin_quote_request/_delete_form.html.twig') }}
{% endblock %}
