{% extends 'admin/base.html.twig' %}

{% block mainTitle %}
<!DOCTYPE html>

<title>QuoteRequest</title>
{% endblock %}

{% block body %}
    <h1>QuoteRequest</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ quote_request.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ quote_request.name }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ quote_request.email }}</td>
            </tr>
            <tr>
                <th>Message</th>
                <td>{{ quote_request.message }}</td>
            </tr>
            <tr>
                <th>Type d'article</th>
                <td>{{ quote_request.articleType }}</td>
            </tr>
            <tr>
                <th>Origine de l'article</th>
                <td>{{ quote_request.articleOrigin }}</td>
            </tr>
            <tr>
                <th>Type de marquage</th>
                <td>{{ quote_request.markingType }}</td>
            </tr>
            <tr>
                <th>Logo</th>
                <td>
                    {% if quote_request.logo %}
                        <a href="{{ asset('uploads/quote-logos/' ~ quote_request.logo) }}" target="_blank" rel="noopener">
                            <img src="{{ asset('uploads/quote-logos/' ~ quote_request.logo) }}"
                                 alt="Logo de la demande" style="max-width: 180px; max-height: 100px;">
                        </a>
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Quantité</th>
                <td>{{ quote_request.quantity }}</td>
            </tr>
            <tr>
                <th>Type d'organisme</th>
                <td>{{ quote_request.organizationType }}</td>
            </tr>
            <tr>
                <th>Nom de l'organisme</th>
                <td>{{ quote_request.organizationName }}</td>
            </tr>
            <tr>
                <th>Téléphone</th>
                <td>{{ quote_request.phone }}</td>
            </tr>
            <tr>
                <th>Utilisateur</th>
                <td>{{ quote_request.user ? quote_request.user.id : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ quote_request.status }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ quote_request.createdAt ? quote_request.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_quote_request_index') }}">back to list</a>

    <a href="{{ path('admin_quote_request_edit', {'id': quote_request.id}) }}">edit</a>

    {{ include('admin/admin_quote_request/_delete_form.html.twig') }}
{% endblock %}
