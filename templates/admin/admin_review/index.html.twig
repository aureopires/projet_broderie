{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Avis</h1>

    <a href="{{ path('admin_review_new') }}">Créer</a>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Produit / Cible</th>
            <th>Contenu</th>
            <th>Statut</th>
            <th>Note</th>
            <th>Créé le</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for review in reviews %}
            <tr>
                <td>{{ review.id }}</td>
                <td>
                    {% if review.product %}
                        {{ review.product.title }}
                    {% else %}
                        <span class="badge bg-secondary">Général (Site)</span>
                    {% endif %}
                </td>
                <td>{{ review.content }}</td>
                <td>{{ review.status }}</td>
                <td>{{ review.rating }}</td>
                <td>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('admin_review_show', {'id': review.id}) }}">Voir</a>
                    <a href="{{ path('admin_review_edit', {'id': review.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucun enregistrement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
