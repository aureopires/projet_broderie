{% extends 'admin/base.html.twig' %}

{% block mainTitle %}
<!DOCTYPE html>

<title>Review index</title>
{% endblock %}

{% block body %}
    <h1>Review index</h1>

    <a href="{{ path('admin_review_new') }}">Create new</a>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Produit / Cible</th>
            <th>Content</th>
            <th>Status</th>
            <th>Rating</th>
            <th>CreatedAt</th>
            <th>actions</th>
        </tr>
        </thead>
        <tbody>
        {% for review in reviews %}
            <tr>
                <td>{{ review.id }}</td>
                <td>
                    {% if review.product %}
                        {{ review.product.title }}
                    {% else %}
                        <span class="badge bg-secondary">Général (Site)</span>
                    {% endif %}
                </td>
                <td>{{ review.content }}</td>
                <td>{{ review.status }}</td>
                <td>{{ review.rating }}</td>
                <td>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('admin_review_show', {'id': review.id}) }}">show</a>
                    <a href="{{ path('admin_review_edit', {'id': review.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
