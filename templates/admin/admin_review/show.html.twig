{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Avis</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ review.id }}</td>
        </tr>
        <tr>
            <th>Produit / Cible</th>
            <td>
                {% if review.product %}
                    {{ review.product.title }}
                {% else %}
                    <span class="badge bg-secondary">Général (Site)</span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Contenu</th>
            <td>{{ review.content }}</td>
        </tr>
        <tr>
            <th>Statut</th>
            <td>{{ review.status }}</td>
        </tr>
        <tr>
            <th>Note</th>
            <td>{{ review.rating }}</td>
        </tr>
        <tr>
            <th>Créé le</th>
            <td>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_review_index') }}">Retour à la liste</a>

    <a href="{{ path('admin_review_edit', {'id': review.id}) }}">Modifier</a>

    {{ include('admin/admin_review/_delete_form.html.twig') }}
{% endblock %}
