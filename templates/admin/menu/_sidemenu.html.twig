
{% trans_default_domain 'admin' %}

<section class="d-flex flex-column mx-auto">
    <a class="navbar-brand mx-auto" href="{{ path("app_home") }}">
        <i class="fa-3x"></i>
    </a>

    <hr>

    <div class="ps-4">
        {% include 'admin/partials/_menu_link.html.twig' with {
            'pathName': 'admin_home',
            'label':  'menu.dashboard'
        } %}
    </div>

    <hr>

    <div class="ps-4">
        <p class="p-0 m-0">{{ 'menu.category.title' }}</p>
        <ul class="list-unstyled ps-2">
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_category_index',
                    'label':  'menu.category.index'
                } %}
            </li>
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_category_new',
                    'label':  'menu.category.new'
                } %}
            </li>
        </ul>
    </div>

    <hr>

    <div class="ps-4">
        <p class="p-0 m-0">{{ 'menu.product.title' }}</p>
        <ul class="list-unstyled ps-2">
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_country_index',
                    'label':  'menu.product.index'
                } %}
            </li>
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_product_new',
                    'label':  'menu.product.new'
                } %}
            </li>
        </ul>
    </div>

    <hr>

    <div class="ps-4">
        <p class="p-0 m-0">{{ 'menu.quote.title' }}</p>
        <ul class="list-unstyled ps-2">
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_quote_index',
                    'label':  'menu.quote.index'
                } %}
            </li>
            <li>
                {% include 'admin/partials/_menu_link.html.twig' with {
                    'pathName': 'admin_quote_new',
                    'label':  'menu.quote.new'
                } %}
            </li>
        </ul>
    </div>
</section>
