{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Produits</h1>

    <a href="{{ path('admin_product_new') }}">Créer</a>


    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Titre</th>
                <th>Description</th>
                <th>Prix indicatif</th>
                <th>Image</th>
                <th>Slug</th>
                <th>Actif</th>
                <th>Créé le</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.id }}</td>
                <td>{{ product.title }}</td>
                <td>{{ product.description }}</td>
                <td>{{ product.indicativePrice }}</td>
                <td>{{ product.image }}</td>
                <td>{{ product.slug }}</td>
                <td>{{ product.isActive ? 'Oui' : 'Non' }}</td>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('admin_product_show', {'id': product.id}) }}">Voir</a>
                    <a href="{{ path('admin_product_edit', {'id': product.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9">Aucun enregistrement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
