{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Produit</h1>

    <a href="{{ path('admin_product_index') }}">Retour à la liste</a>

    <table class="table">
        <tbody>
            <tr>
                <th>Titre</th>
                <td>{{ product.title }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ product.description }}</td>
            </tr>
            <tr>
                <th>Prix indicatif</th>
                <td>{{ product.indicativePrice }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if product.image %}
                        <img src="{{ asset('uploads/products/' ~ product.image) }}"
                             alt="{{ product.title }}"
                             style="width: 120px; height: 90px; object-fit: cover;">
                    {% else %}
                        Aucune image
                    {% endif %}
                </td>
            </tr>
            <tr>
                <th>Actif</th>
                <td>{{ product.isActive ? 'Oui' : 'Non' }}</td>
            </tr>
            <tr>
                <th>Créé le</th>
                <td>{{ product.createdAt ? product.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <h2>Catégories liées</h2>

    {% if product.categories is not empty %}
        <ul>
            {% for category in product.categories %}
                <li>
                    <a href="{{ path('admin_category_show', {'id': category.id}) }}">
                        {{ category.name }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucune catégorie n'est liée à ce produit.</p>
    {% endif %}

    <a href="{{ path('admin_product_edit', {'id': product.id}) }}" class="btn btn-warning">Modifier</a>

    {{ include('admin/admin_product/_delete_form.html.twig') }}
{% endblock %}
