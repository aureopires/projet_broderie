{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Catégories</h1>

    <a href="{{ path('admin_category_new') }}">Créer</a>

    <table class="table">
        <thead>
            <tr>
                <th>Nom</th><th>Image</th><th>Description</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.name }}</td>
                <td>
                    {% if category.image %}
                        <img src="{{ asset('uploads/categories/' ~ category.image) }}"
                             alt="{{ category.name }}"
                             style="width: 80px; height: 60px; object-fit: cover;">
                    {% else %}
                        Aucune image
                    {% endif %}
                </td>                <td>{{ category.description }}</td>
                <td>
                    <a href="{{ path('admin_category_show', {'id': category.id}) }}">Voir</a>
                    <a href="{{ path('admin_category_edit', {'id': category.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">Aucun enregistrement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
