{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Catégories</h1>

    <a href="{{ path('admin_category_new') }}">Créer</a>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th><th>Nom</th><th>Image</th><th>Slug</th><th>Description</th><th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for category in categories %}
            <tr>
                <td>{{ category.id }}</td>
                <td>{{ category.name }}</td>
                <td>{{ category.image }}</td>
                <td>{{ category.slug }}</td>
                <td>{{ category.description }}</td>
                <td>
                    <a href="{{ path('admin_category_show', {'id': category.id}) }}">Voir</a>
                    <a href="{{ path('admin_category_edit', {'id': category.id}) }}">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun enregistrement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
