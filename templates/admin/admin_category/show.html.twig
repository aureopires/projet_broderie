{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Catégorie</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ category.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ category.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ category.image }}</td>
            </tr>
            <tr>
                <th>Slug</th>
                <td>{{ category.slug }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ category.description }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_category_index') }}">Retour à la liste</a>

    <a href="{{ path('admin_category_edit', {'id': category.id}) }}">Modifier</a>

    {{ include('admin/admin_category/_delete_form.html.twig') }}
{% endblock %}
