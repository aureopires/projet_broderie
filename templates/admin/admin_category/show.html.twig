{% extends 'admin/base.html.twig' %}

{% block body %}
    <h1>Catégorie</h1>

    <a href="{{ path('admin_category_index') }}">Retour à la liste</a>

    <table class="table">
        <tbody>
            <tr>
                <th>Nom</th>
                <td>{{ category.name }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>
                    {% if category.image %}
                        <img src="{{ asset('uploads/categories/' ~ category.image) }}"
                             alt="{{ category.name }}"
                             style="width: 120px; height: 90px; object-fit: cover;">
                    {% else %}
                        Aucune image
                    {% endif %}
                </td>            </tr>
            <tr>
                <th>Description</th>
                <td>{{ category.description }}</td>
            </tr>
        </tbody>
    </table>
    <h2>Produits liés</h2>

    {% if category.products is not empty %}
        <ul>
            {% for product in category.products %}
                <li>
                    <a href="{{ path('admin_product_show', {'id': product.id}) }}">
                        {{ product.title }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p>Aucun produit n'est lié à cette catégorie.</p>
    {% endif %}

    <a href="{{ path('admin_category_edit', {'id': category.id}) }} " class="btn btn-warning">Modifier</a>

    {{ include('admin/admin_category/_delete_form.html.twig') }}
{% endblock %}
