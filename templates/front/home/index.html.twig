{% extends 'front/base.html.twig' %}

{% block title %}L'Aiguille des Volcans | Atelier de Broderie Artisanale{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section class="hero-section">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6 mb-4 mb-lg-0">
                    <span class="hero-subtitle">Atelier de broderie, personnalisation textile & couture</span>
                    <h1 class="hero-title mb-4">L'art du fil, <br><span style="font-style: italic; font-weight: normal; color: var(--primary-color);">la beauté du sur-mesure</span></h1>
                    <p class="text-muted mb-4">Des créations uniques brodées avec passion pour les particuliers, professionnels, associations et collectivités.</p>
                    <a href="prestations.html" class="btn btn-gold">Découvrir nos prestations <i class="fas fa-arrow-right ms-2"></i></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Welcome / Accueil Text -->
    <section class="py-5 bg-white">
        <div class="container">
            <div class="row justify-content-center text-center mb-5">
                <div class="col-lg-8">
                    <span class="text-uppercase text-muted small tracking-widest">Bienvenue</span>
                    <h2 class="fw-bold mt-2">Bienvenue dans mon atelier de broderie</h2>
                    <p class="text-muted mt-3">
                        Un espace où créativité, savoir-faire et passion se rencontrent pour donner vie à chacun de vos projets. Je vous accompagne dans la réalisation de créations uniques et personnalisées que vous soyez un particulier, une entreprise, une association ou une collectivité.
                    </p>
                </div>
            </div>

            <!-- Pour qui ? -->
            <div class="row g-4 text-center mt-4">
                <div class="col-md-4">
                    <div class="p-4 border rounded-3 h-100 bg-light">
                        <h4 class="h5 fw-bold mb-3">Pour les particuliers</h4>
                        <p class="text-muted small">Faites plaisir ou faites-vous plaisir ! Rendez vos moments inoubliables grâce à des textiles personnalisés.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 border rounded-3 h-100 bg-light">
                        <h4 class="h5 fw-bold mb-3">Vous êtes professionnels ?</h4>
                        <p class="text-muted small">Je vous aide à transformer votre image d’entreprise grâce à la broderie, la sublimation ou bien le flocage.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-4 border rounded-3 h-100 bg-light">
                        <h4 class="h5 fw-bold mb-3">Les associations</h4>
                        <p class="text-muted small">Développez l'esprit d'équipe et l'identité de votre association avec des textiles de qualité.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Savoir-Faire / Services Section -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="hero-subtitle">Notre savoir-faire</span>
                <h2 class="fw-bold">Des services sur-mesure pour tous vos projets</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="service-card">
                        <div class="mb-3 text-gold fs-3"><i class="fas fa-scroll"></i></div>
                        <h5 class="fw-bold mb-3">Broderie Personnalisée</h5>
                        <p class="text-muted small">Logos, prénoms, motifs ou textes : des broderies de qualité pour sublimer vos textiles.</p>
                        <a href="prestations.html" class="text-dark mt-3 d-inline-block"><i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="service-card">
                        <div class="mb-3 text-gold fs-3"><i class="fas fa-tshirt"></i></div>
                        <h5 class="fw-bold mb-3">Personnalisation Textile</h5>
                        <p class="text-muted small">Vêtements professionnels, tenues d’association, cadeaux personnalisés... Valorisez votre image avec élégance.</p>
                        <a href="prestations.html" class="text-dark mt-3 d-inline-block"><i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="service-card">
                        <div class="mb-3 text-gold fs-3"><i class="fas fa-cut"></i></div>
                        <h5 class="fw-bold mb-3">Couture & Retouches</h5>
                        <p class="text-muted small">Retouches, ajustements ou créations sur mesure : un travail soigné pour un rendu impeccable.</p>
                        <a href="prestations.html" class="text-dark mt-3 d-inline-block"><i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="service-card">
                        <div class="mb-3 text-gold fs-3"><i class="fas fa-gift"></i></div>
                        <h5 class="fw-bold mb-3">Créations Sur-Mesure</h5>
                        <p class="text-muted small">Un projet unique ? Ensemble, donnons vie à vos idées avec des réalisations qui vous ressemblent.</p>
                        <a href="prestations.html" class="text-dark mt-3 d-inline-block"><i class="fas fa-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </section>



{% endblock %}
