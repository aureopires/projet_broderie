{% extends 'front/base.html.twig' %}

{% trans_default_domain 'home' %}

{% block body %}

        <h1 class="text-center">{{ 'title.main'|trans }}</h1>


    <h2>Derniers produits ajoutés :</h2>
    <ul>
        {% for product in products %}
            <li>{{ product.title }} - {{ product.indicativePrice }} €</li>
        {% else %}
            <li>Aucun produit trouvé.</li>
        {% endfor %}
    </ul>

{% endblock %}
