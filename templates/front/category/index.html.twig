{% extends 'front/base.html.twig' %}

{% block body %}
    <h1>Toutes nos Catégories de Broderie</h1>
    <!-- Savoir-Faire / Services Section -->
    <section class="py-5">
        <div class="container">
            <div class="text-center mb-5">
                <span class="hero-subtitle">Notre savoir-faire</span>
                <h2 class="fw-bold">Des services sur-mesure pour tous vos projets</h2>
            </div>
            <div class="row g-4">
            {% for category in categories %}
                <div class="col-md-3">
                    <div class="service-card">
                        <div class="mb-3 text-gold fs-3">
                            <i class="fas fa-scroll"></i>
                        </div>

                        <h5 class="fw-bold mb-3">
                            <a href="{{ path('app_category_show', { slug: category.slug }) }}">
                                {{ category.name }}
                            </a>
                        </h5>

                        <p class="text-muted small">
                            {{ category.description }}
                        </p>
                    </div>
                </div>
            {% else %}
                <p>Aucune catégorie trouvée.</p>
            {% endfor %}
        </div>
    </div>
</section>

    <p style="margin-top: 20px;">
        <a href="{{ path('app_product_index') }}">← Voir tous les produits</a>
    </p>
{% endblock %}
