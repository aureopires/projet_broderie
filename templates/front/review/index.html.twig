{% extends 'front/base.html.twig' %}

{% block title %}Tous les avis - L'Aiguille des Volcans{% endblock %}

{% block body %}

    <!-- Page Header -->
    <section class="py-5 bg-light mb-4">
        <div class="container text-center">
            <h1 class="hero-title mb-2">Avis clients</h1>
            <p class="text-muted">Découvrez les retours de nos clients sur leurs projets de broderie et créations personnalisées.</p>

            {% if app.user %}
                <a href="{{ path('front_review_new') }}" class="btn btn-gold mt-3">
                    <i class="fas fa-pen me-2"></i> Laisser un avis
                </a>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn btn-outline-dark mt-3">
                    Connectez-vous pour laisser un avis
                </a>
            {% endif %}
        </div>
    </section>

    <!-- Liste de tous les Avis -->
    <section class="pb-5">
        <div class="container">
            <div class="row g-4">
                {% for review in reviews %}
                    <div class="col-md-4">
                        <div class="card h-100 border-0 shadow-sm p-3">
                            <div class="card-body d-flex flex-column justify-content-between">
                                <div>
                                    <!-- Étoiles dynamiques (pleines / vides) -->
                                    <div class="mb-3 text-warning">
                                        {% for i in 1..5 %}
                                            {% if i <= review.rating %}
                                                <i class="fas fa-star"></i>
                                            {% else %}
                                                <i class="far fa-star"></i>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                    <p class="card-text text-muted small" style="text-align: justify;">"{{ review.content }}"</p>
                                </div>
                                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                    <span class="fw-bold small text-dark">- {{ review.user ? review.user.userIdentifier : 'Client' }}</span>
                                    <span class="text-muted" style="font-size: 0.75rem;">{{ review.createdAt ? review.createdAt|date('d/m/Y') : '' }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center text-muted py-5">
                        <p class="fs-5">Aucun avis publié pour le moment.</p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

{% endblock %}
