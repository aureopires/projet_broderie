{% extends 'front/base.html.twig' %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Contact - L'Aiguille des Volcans{% endblock %}

{% block body %}

    <!-- Page Header / Title -->
    <section class="py-4 text-center">
        <div class="container">
            <h1 class="hero-title mb-0">Contact</h1>
        </div>
    </section>

    <!-- Contact Content Section -->
    <section class="py-5 bg-white">
        <div class="container">

            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="row align-items-start g-4">

                        <div class="col-md-6">
                            <p class="text-muted" style="line-height: 1.8;">
                                Je suis joignable par téléphone au <strong>0677895869</strong>.<br>
                                Vous pouvez aussi bien-sur venir à l'Atelier qui se situe au <strong>4 Route de Clermont 63530 Volvic</strong> (Il est préférable de téléphoner avant).<br>
                                Retrouvez-moi également sur Facebook et Instagram.
                            </p>

                            <!-- Logo centralizado na coluna -->
                            <div class="text-center my-4">
                                <img src="{{ asset('build/images/logo_nav.png') }}" alt="L'Aiguille des Volcans"
                                     class="img-fluid" style="max-height: 120px;" data-theme-logo>
                            </div>

                            <div class="d-flex justify-content-center gap-3 mb-4">
                                <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook (nouvel onglet)" class="text-decoration-none fs-3" style="color: #1877F2;">
                                    <i class="fab fa-facebook" aria-hidden="true"></i>
                                </a>
                                <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram (nouvel onglet)" class="text-decoration-none fs-3" style="color: #E4405F;">
                                    <i class="fab fa-instagram" aria-hidden="true"></i>
                                </a>
                            </div>

                            <!-- Aviso sobre a loja -->
                            <div class="p-4 bg-light rounded shadow-sm text-center">
                                <p class="fw-bold mb-2">L'Aiguille des Volcans n'est pas un magasin.</p>
                                <p class="text-muted mb-0">L'atelier est ouvert seulement sur rendez-vous.</p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-4 bg-light rounded shadow-sm">
                                {{ form_start(form) }}
                                    {{ include('front/legal/_privacy_notice.html.twig', {purpose: 'répondre à votre message', optionalFields: 'l’entité'}) }}
                                    {% if form.vars.errors|length %}
                                        <div role="alert">{{ form_errors(form) }}</div>
                                    {% endif %}
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            {{ form_row(form.prenom) }}
                                        </div>
                                        <div class="col-md-6">
                                            {{ form_row(form.nom) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(form.entite) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(form.email) }}
                                        </div>
                                        <div class="col-12">
                                            {{ form_row(form.message) }}
                                        </div>
                                        <div class="col-12 text-end">
                                            <button type="submit" class="btn btn-gold px-4">Envoyer</button>
                                        </div>
                                    </div>
                                {{ form_end(form) }}
                            </div>
                        </div>

                    </div>

                    <div class="row mt-5 pt-4 border-top">
                        <div class="col-12">
                            <h3 class="h5 fw-bold mb-3 text-center">Retrouvez l'atelier sur la carte</h3>
                            <div class="ratio ratio-16x9 rounded shadow-sm overflow-hidden">
                                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2777.7!2d3.03!3d45.85!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47f1c!2s4%20Route%20de%20Clermont%2C%2063530%20Volvic!5e0!3m2!1sfr!2sfr!4v1650000000000!5m2!1sfr!2sfr"
                                        title="Localisation de l’atelier L’Aiguille des Volcans" style="border:0;" allowfullscreen="" loading="lazy"></iframe>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    </section>

{% endblock %}
