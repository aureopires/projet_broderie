{% extends 'front/base.html.twig' %}

{% block body %}
    <main class="container quote-page py-5">
        <h1 class="mb-4">Demander un devis</h1>

        {{ form_start(form, {attr: {id: 'quote-request-form'}}) }}
            <div class="quote-form-grid">
                <div class="quote-form-project">
                    {{ form_row(form.message) }}
                    {{ form_row(form.articleType) }}
                    {{ form_row(form.articleOrigin) }}
                    {{ form_row(form.markingType) }}
                    {{ form_row(form.logoFile) }}
                </div>
                <div class="quote-form-contact">
                    {{ form_row(form.quantity) }}
                    <div class="row g-3">
                        <div class="col-md-6">{{ form_row(form.firstName) }}</div>
                        <div class="col-md-6">{{ form_row(form.lastName) }}</div>
                    </div>
                    {{ form_row(form.organizationType) }}
                    {{ form_row(form.organizationName) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.phone) }}
                </div>
            </div>

            <aside id="quote-preview" class="quote-preview" aria-live="polite">
                <h2>Prévisualisation de votre demande</h2>
                <dl>
                    <div>
                        <dt>Article</dt>
                        <dd data-preview="articleType">—</dd>
                    </div>
                    <div>
                        <dt>Marquage</dt>
                        <dd data-preview="markingType">—</dd>
                    </div>
                    <div>
                        <dt>Quantité</dt>
                        <dd data-preview="quantity">—</dd>
                    </div>
                    <div>
                        <dt>Prénom</dt>
                        <dd data-preview="firstName">—</dd>
                    </div>
                    <div>
                        <dt>Nom</dt>
                        <dd data-preview="lastName">—</dd>
                    </div>
                    <div>
                        <dt>Organisme</dt>
                        <dd data-preview="organizationType">—</dd>
                    </div>
                </dl>
            </aside>

            <button type="submit" class="btn btn-gold quote-submit">Envoyer</button>
        {{ form_end(form) }}
    </main>
{% endblock %}
