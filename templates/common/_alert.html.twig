
{% for label, messages in app.flashes %}
    {% for message in messages %}
        {% set alert_type = label in ['error', 'verify_email_error'] ? 'danger' : label %}
        <div class="alert alert-{{ alert_type }} d-flex align-items-center" role="alert">
            {% if alert_type == 'danger' %}
                <i class="fa-solid fa-triangle-exclamation"></i>
            {% elseif alert_type == 'warning' %}
                <i class="fa-solid fa-triangle-exclamation"></i>
            {% elseif alert_type == 'success' %}
                <i class="fa-solid fa-circle-check"></i>
            {% endif %}
            <div class="ms-2">{{ message }}</div>
            <button type="button" class="btn-close ms-auto" aria-label="Fermer" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}
{% endfor %}
