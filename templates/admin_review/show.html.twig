<!DOCTYPE html>

<title>Review</title>

{% block body %}
    <h1>Review</h1>

    <table class="table">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ review.id }}</td>
        </tr>
        <tr>
            <th>Produit / Cible</th>
            <td>
                {% if review.product %}
                    {{ review.product.title }}
                {% else %}
                    <span class="badge bg-secondary">Général (Site)</span>
                {% endif %}
            </td>
        </tr>
        <tr>
            <th>Content</th>
            <td>{{ review.content }}</td>
        </tr>
        <tr>
            <th>Status</th>
            <td>{{ review.status }}</td>
        </tr>
        <tr>
            <th>Rating</th>
            <td>{{ review.rating }}</td>
        </tr>
        <tr>
            <th>CreatedAt</th>
            <td>{{ review.createdAt ? review.createdAt|date('Y-m-d H:i:s') : '' }}</td>
        </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_review_index') }}">back to list</a>

    <a href="{{ path('admin_review_edit', {'id': review.id}) }}">edit</a>

    {{ include('admin_review/_delete_form.html.twig') }}
{% endblock %}
